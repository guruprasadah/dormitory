# Digiicampus portal — single-user setup.
#
# Paste the value of the `user` cookie from the logged-in portal
# (DevTools → Application → Cookies → `user`). It is a JWT.
DIGII_TOKEN=
# Portal origin, e.g. https://<your-institute>.digiicampus.com
DIGII_BASE_URL=

# Demo mode: run on fictional fixtures instead of the portal (screenshots,
# demos, development without a token). Takes precedence over DIGII_* above.
# Set to 1 to enable, or remove/comment out to use real data.
# DEMO_MODE=1
