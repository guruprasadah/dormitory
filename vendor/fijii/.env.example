# Copy to .env and fill in. Never commit .env — it holds a live token.

# JWT from the portal: DevTools -> Application -> Cookies -> the `user` cookie
# (URL-decode the value if it contains `%` sequences).
DIGII_TOKEN=

# Your institution's portal origin. There is no default — you must set this
# (or pass `baseUrl` in code, or use a static token that carries `instituteUrl`).
DIGII_BASE_URL=
